    <aQuery>
        <ClimateQuery title="gmst">
            <axis1 name="temperature">none</axis1>
            <axis2 name="Year">global-mean-surface-temperature-native[@year]</axis2>
            <xPath buildList="true" dataName="global-mean-surface-temperature-native" group="false" sumAll="false">climate-model/global-mean-surface-temperature-native/text()</xPath>
            <comments>Returns global mean surface temp anomaly relative to the 1850-1900 mean.
                Also available is global mean air temperature; in both climate model native or relative to 1850-1900 mean.
                A user can adjust the query to search for any of:
                * global-mean-surface-temperature
                * global-mean-air-temperature
                * global-mean-surface-temperature-native
                * global-mean-air-temperature-native</comments>
        </ClimateQuery>
    </aQuery>

    <aQuery>
        <all-regions/>
        <emissionsQueryBuilder title="emissions by region">
            <axis1 name="GHG">GHG</axis1>
            <axis2 name="Year">emissions</axis2>
            <xPath buildList="true" dataName="emissions" group="false" sumAll="false">*[@type = 'sector' (:collapse:) or @type = 'resource' (:collapse:)](: / *[@type = 'subresource' (: collapse :)] :)//
                *[@type = 'GHG']/emissions/node()</xPath>
            <comments/>
        </emissionsQueryBuilder>
    </aQuery>

    <aQuery>
  <all-regions/>
       <emissionsQueryBuilder title="CO2_negative">
          <axis1 name="region">region</axis1>
          <axis2 name="Year">emissions</axis2>
          <xPath buildList="true" dataName="emissions" group="false" sumAll="false">*[@type = 'sector' (:collapse:)]//CO2/emissions[child::node() &lt; 0]/node()</xPath>
          <comments/>
       </emissionsQueryBuilder>
    </aQuery>

    <aQuery>
        <all-regions/>
        <query title="luc_emissions">
            <axis1 name="region">region</axis1>
            <axis2 name="Year">land-use-change-emission[@year]</axis2>
            <xPath buildList="true" dataName="land-use-change-emission" group="false" sumAll="true">/LandNode[@name='root' or @type='LandNode' (:collapse:)]//
                LandLeaf[true() or @type='LandLeaf' (: collapse :)]/land-carbon-densities/
                land-use-change-emission[@year&gt;1970]/text()</xPath>
            <comments/>
        </query>
    </aQuery>

    <aQuery>
        <all-regions />
        <query title="LUC_above_total">
  <axis1 name="region">region</axis1>
  <axis2 name="Year">above-land-use-change-emission[@year]</axis2>
  <xPath buildList="true" dataName="land-use-change-emission" group="false" sumAll="true">/LandNode[@name='root' or @type='LandNode' (:collapse:)]//LandLeaf[true() or @type='LandLeaf' (: collapse :)]/land-carbon-densities/
              above-land-use-change-emission[@year&gt;1970]/text()</xPath>
  <comments/>
</query>
</aQuery>
